  <diagram id="jPe3Qb0TOYIK__ISElMg" name="Ex 3.">
    <mxGraphModel dx="1397" dy="799" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
